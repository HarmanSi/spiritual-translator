# Copy this file to ".env" and fill in your real values.
# Get these from the Azure Portal after creating a "Speech" resource.

SPEECH_KEY=your_azure_speech_key_here
SPEECH_REGION=your_azure_region_here
# e.g. SPEECH_REGION=centralindia  or  eastus  (whatever region you picked)

# Optional: only needed if you want live syncing to a Google Doc.
# Leave blank/remove this line if you don't want that yet.
GOOGLE_DOC_ID=your_google_doc_id_here
